# Application
APP_ENV=development
APP_NAME=chat-service
APP_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chat_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/chat_db

# LLM Provider
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LLM Upstream Inference
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_API_KEY=your-llm-api-key
LLM_API_ACCESS_TOKEN=your-internal-access-token
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_INPUT_CHARS=20000
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_RETRIES=0

# Retrieval Service
RETRIEVAL_SERVICE_URL=http://localhost:8001
RETRIEVAL_TIMEOUT_SECONDS=10.0

# CORS & Security
CORS_ORIGINS=["http://localhost:3000"]
AUTH_SECRET_KEY=dev-secret-key-change-in-production
